[Unit]
Description=Context Reader scheduled recommendation discovery check
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/context-reader-current/ops/mainland/run-recommendation-cron.py --env /opt/context-reader-current/ops/mainland/.env.runtime --base-url https://context-reader.com
TimeoutStartSec=15min
Nice=10
