# Copy to .env.runtime. Keep all real credentials only on the server.
NEXT_PUBLIC_COMMERCIAL_UI=disabled
NEXT_PUBLIC_USAGE_DETAILS_UI=disabled
ACCOUNT_COOKIE_SECRET=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_VERSION=1
CRON_SECRET=
SITE_NOTIFICATION_EMAIL_TO=
SITE_SMTP_HOST=smtp.163.com
SITE_SMTP_PORT=465
SITE_SMTP_USER=
SITE_SMTP_PASSWORD=
SITE_SMTP_FROM=
DEEPSEEK_API_KEY=
DEEPSEEK_USD_TO_CNY_RATE=7.2
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
ZHIPU_FALLBACK_MODEL=glm-4.5-air
ZHIPU_FALLBACK_ENABLED=true
AI_PRIMARY_WAIT_MS=6000
DEEPSEEK_LOOKUP_MODEL=deepseek-flash
# Optional editorial comparison only; absence always leaves DeepSeek active.
AI_GATEWAY_API_KEY=
EDITORIAL_DEEPSEEK_MODEL=deepseek-flash
# Shared user-facing AI budget (4..32); translations/summaries use at most 1/4, capped at 4.
AI_MAX_CONCURRENCY=16
EDITORIAL_DEEPSEEK_REVIEW_MODEL=deepseek-v4-pro
# Mainland production must never point these compatibility variables at Supabase Cloud.
# Compose overrides them with the internal gateway and SERVICE_ROLE_KEY.
SUPABASE_URL=http://supabase-api:8000
SUPABASE_PUBLIC_URL=https://context-reader.com
SUPABASE_SERVICE_ROLE_KEY=
VOLCENGINE_TTS_APP_ID=
VOLCENGINE_TTS_ACCESS_TOKEN=
VOLCENGINE_TTS_CLUSTER=volcano_tts
VOLCENGINE_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v1/tts
VOLCENGINE_TTS_US_VOICE=en_female_amanda_mars_bigtts
VOLCENGINE_TTS_UK_VOICE=en_female_emily_mars_bigtts
OVERSEAS_FETCH_URL=https://fetch.context-reader.com/api/fetch
OVERSEAS_FETCH_TOKEN=replace-with-a-random-server-only-secret-of-at-least-32-characters
