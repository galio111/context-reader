# Copy to .env.runtime. Keep all real credentials only on the server.
NEXT_PUBLIC_COMMERCIAL_UI=disabled
NEXT_PUBLIC_USAGE_DETAILS_UI=disabled
ACCOUNT_COOKIE_SECRET=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_VERSION=1
CRON_SECRET=
SITE_NOTIFICATION_EMAIL_TO=
SITE_SMTP_HOST=smtp.163.com
SITE_SMTP_PORT=465
SITE_SMTP_USER=
SITE_SMTP_PASSWORD=
SITE_SMTP_FROM=
DEEPSEEK_API_KEY=
DEEPSEEK_USD_TO_CNY_RATE=7.2
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
# Mainland production must never point these compatibility variables at Supabase Cloud.
# Compose overrides them with the internal gateway and SERVICE_ROLE_KEY.
SUPABASE_URL=http://supabase-api:8000
SUPABASE_PUBLIC_URL=https://context-reader.com
SUPABASE_SERVICE_ROLE_KEY=
VOLCENGINE_TTS_APP_ID=
VOLCENGINE_TTS_ACCESS_TOKEN=
VOLCENGINE_TTS_CLUSTER=volcano_tts
VOLCENGINE_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v1/tts
VOLCENGINE_TTS_US_VOICE=en_female_amanda_mars_bigtts
VOLCENGINE_TTS_UK_VOICE=en_female_emily_mars_bigtts
