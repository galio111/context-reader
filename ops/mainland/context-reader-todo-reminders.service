[Unit]
Description=Check pending private Context Reader deadlines
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/context-reader-current/ops/mainland/run-todo-reminders.py --env /opt/context-reader-current/ops/mainland/.env.runtime
TimeoutStartSec=120s
Nice=10
