# Docker Compose values. Copy to .env and never commit the real file.
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_a_long_random_password

# Generated on the server. Never reuse the placeholders below.
JWT_SECRET=generate_at_least_32_random_characters
JWT_EXPIRY=3600
ANON_KEY=generate_an_anon_hs256_jwt
SERVICE_ROLE_KEY=generate_a_service_role_hs256_jwt
PUBLIC_SITE_URL=https://context-reader.com
SUPABASE_PUBLIC_URL=https://context-reader.com
ROLLBACK_SITE_URL=https://context-reader-ten.vercel.app

# Shadow mode uses :80 behind an SSH tunnel. After ICP filing, set the real domain.
SITE_ADDRESS=:80

# Optional off-site backup target, for example cos:context-reader-backups/postgres.
RCLONE_REMOTE=
RCLONE_CONFIG=/root/.config/rclone/rclone.conf
